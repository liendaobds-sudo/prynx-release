{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "PrynX",
  "version": "1.0.0-beta.11",
  "identifier": "com.prynx.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "PrynX - Print made easy!",
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": false,
        "transparent": true,
        "dragDropEnabled": true,
        "additionalBrowserArgs": "--disable-features=msWebView2EnableDraggableRegions,CalculateNativeWinOcclusion --disable-background-timer-throttling --disable-backgrounding-occluded-windows --disable-renderer-backgrounding"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://tauri.localhost asset: http://asset.localhost https://asset.localhost http://localhost:8321 https://*.supabase.co https://www.gstatic.com https://1.1.1.1; script-src 'self' blob:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com asset: http://asset.localhost https://asset.localhost data: blob:; img-src 'self' asset: http://asset.localhost https://asset.localhost http://tauri.localhost http://tile.localhost http://localhost:8321 data: blob: tile:; worker-src 'self' blob:;",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**",
          "**/*"
        ]
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "prynx"
        ]
      }
    },
    "updater": {
      "endpoints": [
        "https://github.com/liendaobds-sudo/prynx-release/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM2OTU4NzRDODIzNjZDOUEKUldTYWJEYUNUSWVWeGwvYlJYRStNcUkzZnJKYjJkdkxmN1pwb0tGSEMyNlFwTVA0V3dyMm8rODQK"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "resources": [
      "binaries/gs/**/*",
      "binaries/tesseract/**/*",
      "bin/pdfium.dll"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "pdf"
        ],
        "name": "PDF Document",
        "description": "PDF Document",
        "role": "Editor",
        "mimeType": "application/pdf"
      }
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installerHooks": "installer-hooks.nsh"
      }
    }
  }
}