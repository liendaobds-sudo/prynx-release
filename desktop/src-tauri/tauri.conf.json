{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "PrynX",
  "version": "1.0.0-beta.1",
  "identifier": "com.prynx.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "PrynX Ã¢â‚¬â€ Print made easy!",
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": false,
        "transparent": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://localhost:8321 https://*.supabase.co https://cdnjs.cloudflare.com; script-src 'self' blob: https://cdnjs.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' asset: http://asset.localhost http://localhost:8321 data: blob: tile:; worker-src 'self' blob:;",
      "assetProtocol": {
        "enable": true,
        "scope": ["**", "**/*"]
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["prynx"]
      }
    },
    "updater": {
      "endpoints": [
        "https://github.com/liendaobds-sudo/prynx-release/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM2OTU4NzRDODIzNjZDOUEKUldTYWJEYUNUSWVWeGwvYlJYRStNcUkzZnJKYjJkdkxmN1pwb0tGSEMyNlFwTVA0V3dyMm8rODQK"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": [
      "binaries/gs/**/*",
      "binaries/tesseract/**/*"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["pdf"],
        "name": "PDF Document",
        "description": "PDF Document",
        "role": "Editor",
        "mimeType": "application/pdf"
      }
    ]
  }
}
