<<
  /ASCII85EncodePages false
  /AllowTransparency true
  /AutoPositionEPSFiles true
  /AutoRotatePages /None
  /Binding /Left
  /CalCMYKProfile (U.S. Web Coated \(SWOP\) v2)
  /CalGrayProfile (Dot Gain 20%)
  /CalRGBProfile (sRGB IEC61966-2.1)
  /CompatibilityLevel 1.6
  /CompressColorPages true
  /CompressGrayPages true
  /CompressMonoPages true
  /CompressPages true
  /ConvertImagesToIndexed true
  /ColorConversionStrategy /LeaveColorUnchanged
  /DoThumbnails false
  /DownsampleColorImages false
  /DownsampleGrayImages false
  /DownsampleMonoImages false
  /EmbedAllFonts true
  /EmbedOpenType true
  /JPEG2000ColorACSImageDict << /TileHeight 256 /TileWidth 256 /Quality 100 >>
  /JPEG2000GrayACSImageDict << /TileHeight 256 /TileWidth 256 /Quality 100 >>
  /LockDistillerParams false
  /Optimize true
  /PassThroughJPEGImages true
  /PreserveCopyPage false
  /PreserveDeviceN true
  /PreserveEPSInfo true
  /PreserveHalftoneInfo false
  /PreserveOPIComments false
  /PreserveOverprintSettings true
  /SubsetFonts true
  /UseFlateCompression true
>> setdistillerparams
<<
  /HWResolution [2400 2400]
  /PageOffset [0 0]
  /PageSize [612.0 792.0]
>> setpagedevice
