{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PPEViewerRenderGraph",
  "description": "Schema dac ta Render Graph va Pass Execution v1 cho PPE Viewer GPU",
  "type": "object",
  "required": [
    "schema_version",
    "graph_id",
    "target_id",
    "viewport",
    "camera",
    "color_contract",
    "nodes",
    "edges",
    "capability_plan"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^1\\.[0-9]+\\.[0-9]+$"
    },
    "graph_id": {
      "type": "string",
      "minLength": 1
    },
    "target_id": {
      "type": "string",
      "minLength": 1
    },
    "viewport": {
      "type": "object",
      "required": ["width_px", "height_px", "dpr"],
      "properties": {
        "width_px": { "type": "integer", "exclusiveMinimum": 0 },
        "height_px": { "type": "integer", "exclusiveMinimum": 0 },
        "dpr": { "type": "number", "exclusiveMinimum": 0 }
      },
      "additionalProperties": false
    },
    "camera": {
      "type": "object",
      "required": ["scale", "offset_x", "offset_y", "rotation_degrees"],
      "properties": {
        "scale": { "type": "number", "exclusiveMinimum": 0 },
        "offset_x": { "type": "number" },
        "offset_y": { "type": "number" },
        "rotation_degrees": {
          "type": "integer",
          "enum": [0, 90, 180, 270]
        }
      },
      "additionalProperties": false
    },
    "color_contract": {
      "type": "object",
      "required": ["proof_mode", "rendering_intent", "overprint_simulation"],
      "properties": {
        "proof_mode": { "type": "boolean" },
        "rendering_intent": {
          "type": "string",
          "enum": ["Perceptual", "RelativeColorimetric", "Saturation", "AbsoluteColorimetric"]
        },
        "overprint_simulation": { "type": "boolean" },
        "display_profile_hash": { "type": "string" },
        "proof_profile_hash": { "type": "string" }
      },
      "additionalProperties": false
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["node_id", "pass_type", "backend", "output_surface_lease_id"],
        "properties": {
          "node_id": { "type": "string", "minLength": 1 },
          "pass_type": {
            "type": "string",
            "enum": [
              "raster_pass",
              "group_blend_pass",
              "smask_pass",
              "color_resolve_pass",
              "overlay_pass",
              "present_blit_pass"
            ]
          },
          "backend": {
            "type": "string",
            "enum": ["gpu_shader", "gpu_blit", "cpu_fallback"]
          },
          "inputs": {
            "type": "array",
            "items": { "type": "string" }
          },
          "output_surface_lease_id": { "type": "string", "minLength": 1 },
          "fallback_reason": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from_node_id", "to_node_id"],
        "properties": {
          "from_node_id": { "type": "string" },
          "to_node_id": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "capability_plan": {
      "type": "object",
      "required": ["total_nodes", "gpu_nodes", "cpu_nodes", "fallback_reasons"],
      "properties": {
        "total_nodes": { "type": "integer", "minimum": 0 },
        "gpu_nodes": { "type": "integer", "minimum": 0 },
        "cpu_nodes": { "type": "integer", "minimum": 0 },
        "fallback_reasons": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
