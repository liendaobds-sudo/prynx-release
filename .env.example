# Application
APP_NAME=PDF Inspection System
DEBUG=false

# Database
DATABASE_URL=postgresql://YOUR_USER:YOUR_PASSWORD@localhost:5432/pdfcompare

# Redis
REDIS_URL=redis://localhost:6379/0

# File Storage
UPLOAD_DIR=./uploads
RESULTS_DIR=./results
MAX_FILE_SIZE_MB=500

# PDF Processing
DEFAULT_DPI=300
PREVIEW_DPI=150
# Windows only: set path to Poppler bin directory
# POPPLER_PATH=C:/poppler/Library/bin

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:80"]

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# Docker PostgreSQL (used by docker-compose)
POSTGRES_USER=pdfuser
POSTGRES_PASSWORD=CHANGE_ME_IN_PRODUCTION
POSTGRES_DB=pdfcompare

# Free/Pro rollout (keep false until license server is migrated)
PRYNX_FEATURE_GATING_ENABLED=false

# ─── Engine chế bản: PrynX Print Engine (PPE) vs Ghostscript ───────────────────
# Bản phát hành no-GS tự nhận biết qua marker trong payload (binaries/gs/NO_GHOSTSCRIPT.txt)
# và KHÔNG dò Ghostscript của máy khách — xem backend/app/core/gs_availability.py.
# Ba biến dưới chỉ dùng khi cần đối chiếu có chủ đích ở máy dev.
#
# Mô phỏng bản no-GS ngay trong vòng dev (1/true = coi như không có Ghostscript):
# PRYNX_NO_GS_BUILD=0
# Trỏ tay Ghostscript (thắng cả marker no-GS):
# GHOSTSCRIPT_PATH=
# auto | ppe | gs — chọn engine tách kẽm/soft-proof:
# PRYNX_PRINT_ENGINE=auto
# Trần RAM mỗi lần render PPE (MiB). Để trống = tự chọn theo RAM máy và số slot
# việc nặng; chỉ đặt số khi cần khoá cứng cho một máy cụ thể.
# PRYNX_PPE_MEMORY_BUDGET_MB=
