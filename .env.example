# Application
APP_NAME=PDF Inspection System
DEBUG=false

# Database
DATABASE_URL=postgresql://YOUR_USER:YOUR_PASSWORD@localhost:5432/pdfcompare

# Redis
REDIS_URL=redis://localhost:6379/0

# File Storage
UPLOAD_DIR=./uploads
RESULTS_DIR=./results
MAX_FILE_SIZE_MB=500

# PDF Processing
DEFAULT_DPI=300
PREVIEW_DPI=150
# Windows only: set path to Poppler bin directory
# POPPLER_PATH=C:/poppler/Library/bin

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:80"]

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# Docker PostgreSQL (used by docker-compose)
POSTGRES_USER=pdfuser
POSTGRES_PASSWORD=CHANGE_ME_IN_PRODUCTION
POSTGRES_DB=pdfcompare

# Free/Pro rollout (keep false until license server is migrated)
PRYNX_FEATURE_GATING_ENABLED=false

# ─── Engine chế bản: PrynX Print Engine (PPE) + PDFium ─────────────────────────
# Trần RAM mỗi lần render PPE (MiB). Để trống = tự chọn theo RAM máy và số slot
# việc nặng; chỉ đặt số khi cần khoá cứng cho một máy cụ thể.
# PRYNX_PPE_MEMORY_BUDGET_MB=

# ─── Danh mục ĐẦY ĐỦ các biến môi trường ───────────────────────────────────────
# File này chỉ liệt kê các biến hay dùng. Danh mục đầy đủ (mặc định, phạm vi, khi nào
# nên đụng tới) ở: docs/CAU_HINH_ENV.md — KIENTRUC (audit 2026-07-29 §D.2).
# Thêm biến môi trường mới thì thêm dòng vào tài liệu đó trong CÙNG PR.
#
# Nhóm hay cần nhất khi hỗ trợ khách:
#
# Trần đồng thời — rule #1: máy yếu mới điều chỉnh, máy >=16GB chạy hết công suất.
# Muốn máy mạnh nhanh hơn: tăng worker TRONG job, KHÔNG tăng số job.
# PRYNX_NUP_WORKERS=            # số process trong 1 job bình bản (để trống = auto theo RAM+CPU)
# STICKER_MAX_WORKERS=          # tương tự cho bình tem bế
# PRYNX_MAX_HEAVY_JOBS=         # trần việc nặng dùng chung (auto: 1 nếu RAM <8GB, còn lại 2)
# PRYNX_MAX_COMPARE_PAGE_PIXELS=  # hạ khi khách so sánh file A0/A1 trên máy yếu
#
# Ép CPU khi GPU treo:
# PRYNX_UPSCALE_FORCE_CPU=0
# PRYNX_BG_FORCE_CPU=0
#
# Chẩn đoán (mặc định TẮT, đừng để bật lâu trên máy khách):
# PRYNX_PERF=0
# PRYNX_SECURITY_DIAG=0
#
# Rollout PrynX Viewer Engine (mặc định giữ policy hiện hành):
# PRYNX_VIEWER_ENGINE_MODE=current   # current | hybrid | ppe-only
# PRYNX_VIEWER_SHADOW_RENDER=0       # 1 = PPE dựng nền, chỉ log hash/timing/soundness
#
# Parity: Rust là BẮT BUỘC cho solver bình bản. Đặt 1 = cho fallback Python,
# KHÔNG đảm bảo kết quả trùng — xem backend/tests/parity/KNOWN_DIVERGENCES.md.
# IMPOSITION_ALLOW_PY_FALLBACK=0
