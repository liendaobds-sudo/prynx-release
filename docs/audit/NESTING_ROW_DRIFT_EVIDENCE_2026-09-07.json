    "script": "\"\"\"Audit lệch hàng 2026-09-07: chỉ đọc PDF/manifest, không solve hoặc gia hạn lease.\"\"\"\n\nimport collections\nimport hashlib\nimport json\nimport logging\nimport sys\nfrom pathlib import Path\n\nimport pikepdf\n\nsys.path.insert(0, str(Path(__file__).resolve().parents[1]))\n\nfrom app.workers.nup_artwork import resolve_manifest_artwork_placement\nfrom app.workers.nup_clip_shape import transform_manifest_polygon_rings\n\n\nlogging.disable(logging.CRITICAL)\nROOT = Path(\"C:/Users/Khanh Pham/AppData/Local/Temp/prynx_manifest_F_w9s0raol\")\nSOURCE = Path(\"D:/pdfcompare/test/test nesting.pdf\")\n\n\ndef sha(path):\n    return hashlib.sha256(path.read_bytes()).hexdigest()\n\n\ndef content_bytes(page):\n    value = page.obj[\"/Contents\"]\n    return (\n        b\"\\n\".join(stream.read_bytes() for stream in value)\n        if isinstance(value, pikepdf.Array) else value.read_bytes()\n    )\n\n\nrecord = json.loads((ROOT / \"result.json\").read_text(encoding=\"utf-8\"))\nassert sha(SOURCE) == record[\"sourceSha256\"]\nrows = []\nwith pikepdf.Pdf.open(ROOT / \"before.pdf\") as before, pikepdf.Pdf.open(ROOT / \"after.pdf\") as after:\n    assert len(before.pages) == len(after.pages) == 26\n    for source_page in (6, 7, 8, 12):\n        order = source_page - 1\n        reference = record[\"references\"][order]\n        manifest_path = ROOT / \"runtime-data/manifests\" / (reference[\"manifestId\"] + \".json\")\n        envelope = json.loads(manifest_path.read_text(encoding=\"utf-8\"))\n        production, manifest = envelope[\"productionRequest\"], envelope[\"manifest\"]\n        bundle, request = production[\"renderBundle\"], production[\"engineRequest\"]\n        assert manifest[\"manifestId\"] == reference[\"manifestId\"]\n        assert envelope[\"layoutFingerprint\"] == reference[\"layoutFingerprint\"]\n        assert len(bundle[\"parts\"]) == 1\n        part = bundle[\"parts\"][0]\n        assert part[\"pages\"][\"front\"][\"pageIndex\"] == order\n        assert part[\"pages\"][\"cut\"][\"pageIndex\"] == order\n        placements = sorted(manifest[\"placements\"], key=lambda item: item[\"instanceId\"].encode(\"utf-8\"))\n        expected = []\n        for placement in placements:\n            resolved = resolve_manifest_artwork_placement(\n                placement=placement, part=part, sheet_frame=bundle[\"sheetFrames\"][\"cut\"],\n                side=\"cut\", render_bundle_hash=production[\"renderBundleHash\"],\n            )\n            rings = transform_manifest_polygon_rings(\n                part[\"cutContour\"], sheet_frame=resolved.sheet_frame, pose=resolved.pose,\n                reference_point_mm=resolved.reference_point_mm,\n            )\n            expected.extend([[(x * 72 / 25.4, y * 72 / 25.4) for x, y in ring] for ring in rings])\n        cut_index = 2 * order + 1\n        actual, group, magenta = [], [], False\n        cut_operations = list(pikepdf.parse_content_stream(after.pages[cut_index]))\n        cm_count = sum(str(operator) == \"cm\" for _, operator in cut_operations)\n        do_count = sum(str(operator) == \"Do\" for _, operator in cut_operations)\n        assert cm_count == 0 and do_count == 0, \"CUT phải là tọa độ tờ trực tiếp, không CTM/Form ẩn\"\n        assert int(after.pages[cut_index].obj.get(\"/Rotate\", 0)) == 0\n        assert float(after.pages[cut_index].obj.get(\"/UserUnit\", 1)) == 1\n        for operands, operator in cut_operations:\n            op = str(operator)\n            if op == \"K\":\n                magenta = tuple(map(float, operands)) == (0.0, 1.0, 0.0, 0.0)\n                if not magenta:\n                    group = []\n            if op == \"m\" and magenta:\n                group.append([tuple(map(float, operands))])\n            elif op == \"l\" and magenta:\n                group[-1].append(tuple(map(float, operands)))\n            elif op == \"S\":\n                if magenta:\n                    actual.extend(group)\n                group = []\n        assert len(actual) == len(expected)\n        assert all(len(a) == len(e) for a, e in zip(actual, expected))\n        max_error = max(\n            abs(a - e) for ar, er in zip(actual, expected)\n            for ap, ep in zip(ar, er) for a, e in zip(ap, ep)\n        )\n        assert max_error < 1e-8\n        # Đây là dải theo tọa độ tham chiếu pose, không giả vờ là phân đoạn hàng vật lý.\n        band_y = 60.0 if source_page == 12 else 35.0\n        bottom = [p for p in placements if p[\"pose\"][\"translateYmm\"] < band_y]\n        upper = [p for p in placements if p[\"pose\"][\"translateYmm\"] >= band_y]\n        current_bytes = content_bytes(after.pages[cut_index])\n        before_equal = content_bytes(before.pages[cut_index]) == current_bytes\n        assert before_equal\n        rows.append({\n            \"sourcePage1Based\": source_page,\n            \"outputCutPage1Based\": cut_index + 1,\n            \"manifestFile\": str(manifest_path),\n            \"manifestFileSha256\": sha(manifest_path),\n            \"manifestId\": manifest[\"manifestId\"],\n            \"placementCount\": len(placements),\n            \"cutRingCount\": len(actual),\n            \"comparedVertexCount\": sum(map(len, actual)),\n            \"maxCoordinateErrorPt\": max_error,\n            \"cutCmOperatorCount\": cm_count,\n            \"cutDoOperatorCount\": do_count,\n            \"beforeAfterCutDecodedBytesEqual\": before_equal,\n            \"cutDecodedSha256\": hashlib.sha256(current_bytes).hexdigest(),\n            \"angles\": dict(collections.Counter(str(p[\"pose\"][\"rotationDeg\"]) for p in placements)),\n            \"bottomBand\": {\n                \"referenceYBelowMm\": band_y, \"count\": len(bottom),\n                \"distinctYmm\": sorted(set(p[\"pose\"][\"translateYmm\"] for p in bottom)),\n            },\n            \"aboveBottomBand\": {\n                \"count\": len(upper),\n                \"distinctYCount\": len(set(p[\"pose\"][\"translateYmm\"] for p in upper)),\n            },\n            \"first14Poses\": [{\"instanceId\": p[\"instanceId\"], **p[\"pose\"]} for p in placements[:14]],\n            \"sourceCutOuterVertices\": len(part[\"cutContour\"][\"outer\"]),\n            \"sourceCutHoles\": len(part[\"cutContour\"][\"holes\"]),\n            \"profile\": request[\"profile\"], \"timeBudgetMs\": request.get(\"timeBudgetMs\"),\n            \"orientationPolicy\": request[\"orientationPolicy\"],\n            \"stats\": manifest[\"stats\"], \"search\": manifest[\"search\"],\n            \"provenance\": manifest[\"provenance\"],\n        })\n\nprint(json.dumps({\n    \"scope\": \"Đọc artifact F có sẵn và 4 manifest; không solve/native-validate, không renew lease; dải Y là tham chiếu pose, không phải phân đoạn hàng.\",\n    \"source\": str(SOURCE), \"sourceSha256\": sha(SOURCE),\n    \"recordedSourceSha256\": record[\"sourceSha256\"],\n    \"beforePdf\": str(ROOT / \"before.pdf\"), \"beforePdfSha256\": sha(ROOT / \"before.pdf\"),\n    \"afterPdf\": str(ROOT / \"after.pdf\"), \"afterPdfSha256\": sha(ROOT / \"after.pdf\"),\n    \"rows\": rows,\n}, ensure_ascii=True))\n\r\n"
